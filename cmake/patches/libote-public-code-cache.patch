diff --git a/libOTe/Tools/BlkAccCode/PublicCodeCache.h b/libOTe/Tools/BlkAccCode/PublicCodeCache.h
--- /dev/null
+++ b/libOTe/Tools/BlkAccCode/PublicCodeCache.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <map>
+#include <memory>
+#include <mutex>
+#include <type_traits>
+#include <vector>
+#include "cryptoTools/Common/Defines.h"
+#include "libOTe/Tools/CoeffCtx.h"
+
+namespace osuCrypto::detail {
+
+// Public code descriptions only. Never cache OT outputs or private vectors.
+// Stored index/coefficient data is bounded to 16 MiB per process.
+struct PublicCodeCacheState {
+    std::mutex mutex;
+    std::map<std::vector<u64>, std::shared_ptr<const std::vector<u32>>> entries;
+    size_t bytes = 0;
+};
+
+inline PublicCodeCacheState& publicCodeCache() {
+    static PublicCodeCacheState cache;
+    return cache;
+}
+
+template <typename Builder>
+std::shared_ptr<const std::vector<u32>> cachedPublicCode(
+    const std::vector<u64>& key, Builder&& build) {
+    auto& cache = publicCodeCache();
+    std::lock_guard<std::mutex> lock(cache.mutex);
+    auto found = cache.entries.find(key);
+    if (found != cache.entries.end()) return found->second;
+    auto data = std::make_shared<const std::vector<u32>>(build());
+    const size_t bytes = data->size() * sizeof(u32);
+    if (bytes <= (size_t{16} << 20) - cache.bytes) {
+        cache.entries.emplace(key, data);
+        cache.bytes += bytes;
+    }
+    return data;
+}
+
+} // namespace osuCrypto::detail
